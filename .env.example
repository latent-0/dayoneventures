# ---------------------------------------------------------------------------
# Contact-form lead delivery (Resend)
# Copy this file to `.env` for local dev. On Vercel, set these as
# Environment Variables in the project settings (Production + Preview).
# ---------------------------------------------------------------------------

# Required. Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides (these defaults are baked into src/lib/leads.ts, so you
# do NOT need to set these unless you want different values):
# Where leads are delivered.
LEAD_TO_EMAIL=contact@dayoneventurepartners.com
# Copied on every lead.
LEAD_CC_EMAIL=kim@day1tech.com
# From address. Needs only a VERIFIED DOMAIN in Resend, not a real mailbox.
LEAD_FROM_EMAIL=Dayone Ventures <contact@dayoneventurepartners.com>
