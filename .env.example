# ---------------------------------------------------------------------------
# Contact-form lead delivery
# Copy this file to `.env` for local dev. On Vercel, set these as
# Environment Variables in the project settings (Production + Preview).
#
# Configure AT LEAST ONE channel below. If both are set, a lead is written
# to both and the submission succeeds if either one accepts it.
# ---------------------------------------------------------------------------

# --- Channel 1: Google Sheet (via an Apps Script web app) --------------------
# Deploy apps-script/Code.gs as a Web App (see apps-script/Code.gs for steps)
# and paste its /exec URL here.
LEAD_SHEET_URL=
# Optional shared secret. Set the SAME value as the script's LEAD_TOKEN
# script property. Leave blank to skip the check.
LEAD_SHEET_TOKEN=

# --- Channel 2: Email (Resend) --------------------------------------------- #
# Resend API key — https://resend.com/api-keys . Needs the sending domain
# verified in Resend. Leave blank to disable email delivery.
RESEND_API_KEY=

# Optional email overrides (defaults are baked into src/lib/leads.ts):
LEAD_TO_EMAIL=contact@dayoneventurepartners.com
LEAD_CC_EMAIL=kim@day1tech.com
LEAD_FROM_EMAIL=Dayone Ventures <contact@dayoneventurepartners.com>
